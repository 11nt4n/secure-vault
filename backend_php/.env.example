# ============================================================
# Secure Vault - Environment Configuration
# Salin menjadi ".env" (di folder yang sama dengan index.php)
# ============================================================

# production | development
APP_ENV=production

# Mode demo: buat akun admin/admin123 & user/user123 dan terima TOTP "123456".
# JANGAN aktifkan di server publik.
DEMO_MODE=false

# Izinkan pendaftaran mandiri (akun baru selalu berperan "user")
ALLOW_REGISTRATION=true

# Rahasia penandatangan JWT (min. 32 karakter acak). Jika kosong, dibuat otomatis
# dan disimpan di SV_DATA_DIR/.jwt_secret
# Contoh pembuatan: php -r "echo bin2hex(random_bytes(48));"
JWT_SECRET=

# Lama sesi (detik)
JWT_TTL_SECONDS=900

# Akun administrator awal (hanya dipakai saat database pertama kali dibuat).
# Jika ADMIN_PASSWORD kosong, password acak ditulis ke SV_DATA_DIR/INITIAL_ADMIN_PASSWORD.txt
ADMIN_USERNAME=admin
ADMIN_EMAIL=admin@example.go.id
ADMIN_PASSWORD=

# Lokasi data (SQLite, log) & ciphertext. Sebaiknya DI LUAR web root.
# SV_DATA_DIR=/var/lib/securevault/data
# SV_STORAGE_DIR=/var/lib/securevault/storage

# Batas & kuota
MAX_FILE_BYTES=524288000
DEFAULT_QUOTA_BYTES=5368709120

# Hanya jika frontend berada di origin berbeda (pisahkan dengan koma)
CORS_ALLOWED_ORIGINS=

# Set true hanya jika berada di belakang reverse proxy tepercaya (Cloudflare/Nginx)
TRUST_PROXY=false

TOTP_ISSUER=Secure Vault
